<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List: NOT inline-editable, so a click opens the record. The old
         editable="bottom" meant there was nothing to open, which is why
         the screen looked read-only. -->
    <record id="mudon_wa_template_view_tree" model="ir.ui.view">
        <field name="name">mudon.wa.template.list</field>
        <field name="model">mudon.wa.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates"
                  decoration-success="is_ready"
                  decoration-warning="meta_status == 'PENDING'"
                  decoration-danger="meta_status in ('REJECTED', 'NOT FOUND')">
                <field name="message_key"/>
                <field name="template_name"/>
                <field name="lang_code"/>
                <field name="meta_status"/>
                <field name="meta_category"/>
                <field name="is_ready" string="Working"/>
                <field name="meta_checked_on" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_check_meta" type="object" icon="fa-refresh"
                        title="Check this template's status with Meta"/>
            </list>
        </field>
    </record>

    <record id="mudon_wa_template_view_form" model="ir.ui.view">
        <field name="name">mudon.wa.template.form</field>
        <field name="model">mudon.wa.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <header>
                    <button name="action_submit_to_meta" type="object"
                            string="Send to Meta for approval"
                            class="btn-primary" icon="fa-paper-plane"
                            invisible="meta_status == 'APPROVED'"
                            confirm="Send this wording to Meta for approval? Review usually takes a few minutes. You cannot change the wording afterwards — you would create a new one."/>
                    <button name="action_check_meta" type="object"
                            string="Check status with Meta"
                            class="btn-secondary" icon="fa-refresh"/>
                    <field name="is_ready" invisible="1"/>
                    <field name="submitted" invisible="1"/>
                </header>
                <sheet>
                    <!-- Status banners: the single most useful thing on this
                         screen. Turning a template on before Meta approved it
                         is what silently stopped the agent alerts. -->
                    <div class="alert alert-success d-flex align-items-center"
                         role="alert" invisible="not is_ready">
                        <i class="fa fa-check-circle fa-2x me-3"/>
                        <div><b>Working.</b> Meta has approved this template and it is
                            switched on, so these messages will reach people even if
                            they have never written to you.</div>
                    </div>
                    <div class="alert alert-warning d-flex align-items-center"
                         role="alert" invisible="meta_status != 'PENDING'">
                        <i class="fa fa-clock-o fa-2x me-3"/>
                        <div><b>Meta is still reviewing this.</b> Leave it switched
                            off until the status says APPROVED — sending a template
                            under review fails and the message never arrives.
                            Review usually takes minutes to a few hours.</div>
                    </div>
                    <div class="alert alert-danger d-flex align-items-center"
                         role="alert" invisible="meta_status not in ('REJECTED', 'NOT FOUND')">
                        <i class="fa fa-exclamation-triangle fa-2x me-3"/>
                        <div><b>Not usable.</b> Either Meta rejected it, or no template
                            with this exact name and language exists on your account.
                            Check the spelling against WhatsApp Manager — the name is
                            case-sensitive and the language must match too.</div>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="meta_category != 'MARKETING'">
                        <b>Meta has classified this as MARKETING.</b> Marketing
                        messages are not delivered to anyone who has switched off
                        marketing messages in WhatsApp, so some people will not
                        receive it. Templates that read as a reply to the customer
                        are usually classified UTILITY, which always gets through.
                    </div>

                    <div class="oe_title">
                        <label for="message_key" string="This template is used for"/>
                        <h1><field name="message_key" placeholder="Pick a message"/></h1>
                    </div>

                    <group>
                        <group string="Settings">
                            <field name="template_name"
                                   placeholder="e.g. mudon_new_lead_greeting"
                                   readonly="meta_status == 'APPROVED'"/>
                            <field name="lang_code" placeholder="en"
                                   readonly="meta_status == 'APPROVED'"/>
                            <field name="category"
                                   readonly="meta_status == 'APPROVED'"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Status at Meta">
                            <field name="meta_status" placeholder="not sent yet"/>
                            <field name="meta_category"/>
                            <field name="meta_checked_on"/>
                        </group>
                    </group>

                    <separator string="Write the message"/>
                    <field name="has_problems" invisible="1"/>
                    <div class="row">
                        <div class="col-lg-7">
                            <div class="text-muted mb-2">
                                Type the message exactly as it should arrive.
                                Where a detail from the lead belongs, type it in
                                curly brackets, for example
                                <code>{client name}</code>.
                            </div>
                            <field name="body_wording" nolabel="1"
                                   readonly="meta_status == 'APPROVED'"
                                   placeholder="Pick a message above and a starting wording appears here, ready to edit."/>
                        </div>
                        <div class="col-lg-5">
                            <div class="border rounded p-2 bg-light">
                                <b>You can use</b>
                                <field name="token_help" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Meta refuses wording for reasons it only reveals hours
                         later, so every rule we have been refused for is shown
                         here as the wording is typed. -->
                    <div class="alert alert-warning mt-3" role="alert"
                         invisible="not has_problems">
                        <b>Meta would refuse this as it stands.</b>
                        <field name="problems" nolabel="1" readonly="1"/>
                    </div>

                    <separator string="What they will receive"/>
                    <div class="border rounded p-3 bg-white">
                        <field name="preview_text" nolabel="1" readonly="1"
                               class="mb-0"
                               placeholder="The message appears here as the client will read it, with real details filled in."/>
                    </div>

                    <div class="text-muted small mt-2"
                         invisible="meta_status == 'APPROVED'">
                        When it reads the way you want and there are no warnings
                        above, press <b>Send to Meta for approval</b> at the top.
                    </div>

                    <group string="The numbered form Meta receives"
                           invisible="not body_text">
                        <field name="body_text" nolabel="1" readonly="1"/>
                    </group>

                    <group string="Approved wording, as Meta stored it"
                           invisible="not meta_body">
                        <field name="meta_body" nolabel="1" readonly="1"/>
                    </group>

                    <!-- Short course for whoever opens this screen next. -->
                    <div class="alert alert-secondary mt-3" role="alert">
                        <h4 class="alert-heading">How this works, in short</h4>
                        <p>WhatsApp does not let a business send whatever it likes.
                           Free typing is only allowed for 24 hours after the
                           <i>customer</i> writes to you. Every message this CRM
                           sends starts the conversation, so it has to use wording
                           Meta approved in advance. That approved wording is a
                           <b>template</b>.</p>
                        <p class="mb-1"><b>To set one up, all from this page:</b></p>
                        <ol class="mb-2">
                            <li>Choose which message it is, at the top. A starting
                                wording appears, already correct — edit it freely.</li>
                            <li>Press <b>Send to Meta for approval</b>.</li>
                            <li>Wait for the banner to turn green. Press
                                <b>Check status with Meta</b> to refresh it.</li>
                            <li>Switch it on with the Active toggle.</li>
                        </ol>
                        <p class="mb-2">You do not need to open WhatsApp Manager.
                           If you already made a template there, just type its exact
                           name and language here and press Check status instead.</p>
                        <p class="mb-0"><b>If a message has no template here</b>, it is
                           sent as ordinary text instead. That still works for someone
                           who wrote to you in the last 24 hours, and quietly reaches
                           nobody otherwise.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mudon_wa_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">mudon.wa.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Point each message at an approved template</p>
            <p>WhatsApp only allows free typing for 24 hours after a customer
               writes to you. Everything the CRM sends starts the conversation,
               so it must use wording Meta approved beforehand.</p>
            <p>Open any row to set it up — the form explains each field and can
               check the approval status with Meta for you.</p>
        </field>
    </record>

    <!-- Refresh every row's status in one go. -->
    <record id="action_mudon_wa_template_check_all" model="ir.actions.server">
        <field name="name">Check all statuses with Meta</field>
        <field name="model_id" ref="model_mudon_wa_template"/>
        <field name="binding_model_id" ref="model_mudon_wa_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_check_all_meta()</field>
    </record>

    <menuitem id="mudon_menu_wa_templates"
              name="WhatsApp Templates"
              parent="mudon_menu_config_root"
              action="mudon_wa_template_action"
              sequence="40"/>

</odoo>
