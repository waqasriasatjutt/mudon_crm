<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Inherits the standard Pipeline form and lays out all 7 stages
        worth of Mudon-specific fields across grouped sections. Per-
        pipeline visibility is driven by the computed
        `mudon_pipeline_kind` marker; the stage-currentness of each
        group is driven by lookups against the seeded stage xmlids
        via the lead's `stage_id` field name.
    -->
    <record id="mudon_crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.mudon</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!--
                Inject Stage 1 (New Lead) fields directly into the
                main opportunity body, right after the phone block
                (anchored at lost_reason_id which sits one line below
                phone in Odoo 19's stock form). The Mudon notebook
                page keeps the Stage 2-7 working fields only.

                The 4 fields MService / MCity / MPriority / MBudget
                are flagged required="..." at the view layer (UX —
                user sees the red border immediately) AND validated
                in the backend write() override (safety — blocks
                stage drag-and-drop without these set).
            -->
            <xpath expr="//field[@name='lost_reason_id']" position="before">
                <field name="mudon_pipeline_kind" invisible="1"/>
                <field name="mudon_card_color_hint" invisible="1"/>
                <field name="mudon_kanban_priority_rank" invisible="1"/>
                <field name="mudon_stage_kind_current" invisible="1"/>
                <field name="mudon_show_city_other" invisible="1"/>
                <field name="mudon_budget_currency_id" invisible="1"/>

                <!--
                    v19.0.1.3.0 — CURRENT-STAGE ACTION BLOCK, ON TOP.
                    Only the field(s) the current stage introduces show
                    here, at the top of the form, so the agent fills the
                    next step first. Earlier-stage fields stay available
                    in the "Lead details" section below + the All-Stages
                    notebook page, so data carries forward as the lead
                    advances. New Lead has no single "next field" — the
                    intake below IS the work — so this header is hidden
                    on new_lead.
                -->
                <separator string="▶ Next step — complete to advance this lead"
                           invisible="not mudon_pipeline_kind or mudon_stage_kind_current in ('new_lead', 'won', 'lost') or not mudon_stage_kind_current"/>
                <field name="mudon_tick_offer_sent"
                       string="Offer Sent → Offer Sent stage"
                       invisible="mudon_stage_kind_current != 'qualified'"/>
                <!-- Offer Sent stage controls: counter + button.
                     "+ Mark New Offer Sent" is the agent-facing action
                     each time they share new property videos/photos on
                     WhatsApp — the counter and 3-hr SLA cron pivot off
                     this. -->
                <label for="mudon_offer_counter"
                       invisible="mudon_stage_kind_current != 'offer_sent'"/>
                <div class="o_row"
                     invisible="mudon_stage_kind_current != 'offer_sent'">
                    <field name="mudon_offer_counter" readonly="1" nolabel="1"
                           style="width:60px"/>
                    <span class="text-muted ms-2">/ 10</span>
                    <button name="action_mudon_mark_offer_sent" type="object"
                            string="+ Mark New Offer Sent"
                            class="btn btn-primary ms-3"
                            confirm="Confirm a new offer was sent to the client. The counter will increment by 1 and a 3-hour follow-up reminder will be queued."/>
                </div>
                <field name="mudon_seriousness"
                       invisible="mudon_stage_kind_current != 'offer_sent'"/>
                <field name="mudon_last_offer_date" readonly="1"
                       invisible="mudon_stage_kind_current != 'offer_sent'"/>
                <field name="mudon_visit_confirmed"
                       widget="boolean_toggle"
                       string="Visit Confirmed → Meeting stage"
                       invisible="mudon_stage_kind_current != 'offer_sent'"/>
                <!-- Meeting stage controls -->
                <field name="mudon_client_type"
                       invisible="mudon_stage_kind_current != 'meeting'"/>
                <field name="mudon_property_requirements"
                       invisible="mudon_stage_kind_current != 'meeting'"/>
                <field name="mudon_paid_booking"
                       string="Paid Booking → EOI / Booking stage"
                       invisible="mudon_stage_kind_current != 'meeting'"/>
                <field name="mudon_fully_paid"
                       string="Fully Paid → WON (SPA Signed)"
                       invisible="mudon_stage_kind_current != 'eoi'"/>

                <!--
                    WON (SPA Signed) stage — closing details + funnel
                    triggers, shown on top when the lead is on WON.
                -->
                <separator string="▶ WON — closing details"
                           invisible="mudon_stage_kind_current != 'won'"/>
                <field name="mudon_closing_amount"
                       invisible="mudon_stage_kind_current != 'won'"/>
                <field name="mudon_developer_id"
                       invisible="mudon_stage_kind_current != 'won'"
                       options="{'no_create_edit': True}"/>
                <field name="mudon_project_id"
                       invisible="mudon_stage_kind_current != 'won'"
                       domain="[('pipeline_kind', 'in', [mudon_pipeline_kind, 'any'])]"
                       options="{'no_create_edit': True}"/>
                <field name="mudon_commission"
                       invisible="mudon_stage_kind_current != 'won'"/>
                <field name="mudon_handover_type"
                       invisible="mudon_stage_kind_current != 'won'"/>
                <field name="mudon_reason_to_win"
                       invisible="mudon_stage_kind_current != 'won'"/>
                <separator string="Admin Funnel"
                           invisible="mudon_stage_kind_current != 'won'"/>
                <field name="mudon_need_invoice"
                       invisible="mudon_stage_kind_current != 'won'"/>
                <separator string="After-Sales Funnel"
                           invisible="mudon_stage_kind_current != 'won'"/>
                <field name="mudon_title_deed_required"
                       invisible="mudon_stage_kind_current != 'won'"/>
                <field name="mudon_citizenship_required"
                       invisible="mudon_stage_kind_current != 'won' or mudon_pipeline_kind != 'turkey'"/>
                <field name="mudon_residence_required"
                       invisible="mudon_stage_kind_current != 'won' or mudon_pipeline_kind != 'uae'"/>
                <field name="mudon_furniture_required"
                       invisible="mudon_stage_kind_current != 'won'"/>

                <!--
                    Stage 1 intake — the SAME fields double as the New
                    Lead "current stage" action (prominent header, on top
                    to fill) and, once the lead advances, a plain "Lead
                    details" reference the agent can still review / edit.
                    Two complementary separators swap the heading by
                    stage; the fields below are shown once (no dup).
                -->
                <separator string="▶ New Lead — capture the enquiry, then drag the card to Qualified"
                           invisible="not mudon_pipeline_kind or mudon_stage_kind_current != 'new_lead'"/>
                <separator string="Lead details"
                           invisible="not mudon_pipeline_kind or mudon_stage_kind_current == 'new_lead'"/>
                <field name="mudon_service_id"
                       options="{'no_create_edit': True}"
                       domain="[('pipeline_kind', 'in', [mudon_pipeline_kind, 'any'])]"
                       invisible="not mudon_pipeline_kind"
                       required="mudon_pipeline_kind and mudon_stage_kind_current != 'new_lead'"/>
                <field name="mudon_city_id"
                       options="{'no_create_edit': True}"
                       domain="[('pipeline_kind', 'in', [mudon_pipeline_kind, 'any'])]"
                       invisible="not mudon_pipeline_kind"
                       required="mudon_pipeline_kind and mudon_stage_kind_current != 'new_lead'"/>
                <field name="mudon_city_other"
                       invisible="not mudon_show_city_other"/>
                <field name="mudon_priority"
                       invisible="not mudon_pipeline_kind"
                       required="mudon_pipeline_kind and mudon_stage_kind_current != 'new_lead'"/>
                <field name="mudon_budget"
                       invisible="not mudon_pipeline_kind"
                       required="mudon_pipeline_kind and mudon_stage_kind_current != 'new_lead'"/>
                <field name="mudon_status_id"
                       options="{'no_create_edit': True}"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_nationality_id"
                       invisible="not mudon_pipeline_kind"
                       options="{'no_create': True}"/>
                <field name="mudon_living_in_id"
                       invisible="not mudon_pipeline_kind"
                       options="{'no_create': True}"/>
                <label for="mudon_in_country" string="In Turkey Now"
                       invisible="mudon_pipeline_kind != 'turkey'"/>
                <label for="mudon_in_country" string="In UAE Now"
                       invisible="mudon_pipeline_kind != 'uae'"/>
                <field name="mudon_in_country" nolabel="1"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_cbi_files"
                       invisible="mudon_pipeline_kind != 'turkey'"/>
                <field name="mudon_branch_id" readonly="1"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_purpose_ids"
                       widget="many2many_tags"
                       options="{'no_create_edit': True, 'color_field': 'color'}"
                       domain="[('pipeline_kind', 'in', [mudon_pipeline_kind, 'any'])]"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_property_type_ids"
                       widget="many2many_tags"
                       options="{'no_create_edit': True, 'color_field': 'color'}"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_beds"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_other_specs"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_visit_date"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_notes"
                       invisible="not mudon_pipeline_kind"/>
                <field name="mudon_source_id"
                       options="{'no_create_edit': True}"
                       invisible="not mudon_pipeline_kind"/>

                <!--
                    Move to Lost — pick a reason from any active stage to
                    send the lead to Lost. Read-only once on Lost so the
                    reason can be reviewed but not changed accidentally.
                -->
                <separator string="Move to Lost"
                           invisible="not mudon_pipeline_kind or mudon_stage_kind_current == 'won'"/>
                <field name="mudon_lost_reason_id"
                       string="Lost Reason"
                       options="{'no_create_edit': True}"
                       readonly="mudon_stage_kind_current == 'lost'"
                       invisible="not mudon_pipeline_kind or mudon_stage_kind_current == 'won'"/>
            </xpath>

            <!--
                The Mudon notebook page now hosts Stage 2-7 only —
                Stage 1 lives in the main form above.
            -->
            <xpath expr="//notebook" position="inside">
                <page string="Mudon — Stages 2-7" name="mudon_page"
                      invisible="not mudon_pipeline_kind">
                    <!-- Stage 2: Qualified -->
                    <group string="Stage 2 — Qualified" colspan="2">
                        <field name="mudon_tick_offer_sent"
                               help="Tick to advance the lead to Stage 3."/>
                    </group>

                    <!-- Stage 3: Offer Sent -->
                    <group string="Stage 3 — Offer Sent">
                        <group>
                            <field name="mudon_offer_counter"
                                   help="Auto-bumped each time MTick: Offer Sent is set."/>
                            <field name="mudon_last_offer_date" readonly="1"/>
                            <field name="mudon_seriousness"/>
                            <field name="mudon_visit_confirmed"
                                   widget="boolean_toggle"
                                   help="Tick to advance to Stage 4 (Meeting)."/>
                        </group>
                        <group>
                            <field name="mudon_3rd_offer_survey_sent"
                                   readonly="1"/>
                            <field name="mudon_survey_received_offer"/>
                            <field name="mudon_survey_suitable"/>
                            <field name="mudon_survey_needs_support"/>
                            <field name="mudon_survey_property_options"/>
                            <field name="mudon_survey_status"/>
                            <field name="mudon_survey_preferred_support"/>
                        </group>
                    </group>

                    <!-- Stage 4: Meeting -->
                    <group string="Stage 4 — Meeting">
                        <group>
                            <field name="mudon_client_type"/>
                            <field name="mudon_property_requirements"/>
                        </group>
                        <group>
                            <field name="mudon_paid_booking"
                                   help="Tick to advance to Stage 5 (EOI / Booking)."/>
                        </group>
                    </group>

                    <!-- Stage 5: EOI / Booking -->
                    <group string="Stage 5 — EOI / Booking" colspan="2">
                        <field name="mudon_fully_paid"
                               help="Tick to advance to Stage 6 (WON / SPA Signed)."/>
                    </group>

                    <!-- Stage 6: WON (SPA Signed) -->
                    <group string="Stage 6 — WON (SPA Signed)">
                        <group>
                            <field name="mudon_closing_amount"/>
                            <field name="mudon_developer_id"/>
                            <field name="mudon_project_id"
                                   domain="[('pipeline_kind', 'in', [mudon_pipeline_kind, 'any'])]"/>
                            <field name="mudon_commission"/>
                            <field name="mudon_handover_type"/>
                            <field name="mudon_reason_to_win"/>
                        </group>
                        <group string="Funnel Triggers (Y/N)">
                            <field name="mudon_need_invoice"/>
                            <field name="mudon_title_deed_required"/>
                            <field name="mudon_citizenship_required"
                                   invisible="mudon_pipeline_kind != 'turkey'"/>
                            <field name="mudon_residence_required"
                                   invisible="mudon_pipeline_kind != 'uae'"/>
                            <field name="mudon_furniture_required"/>
                        </group>
                        <group string="Spawned Tasks" colspan="2">
                            <field name="mudon_admin_task_ids" nolabel="1"
                                   readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="assigned_user_id"/>
                                </list>
                            </field>
                            <field name="mudon_after_sales_task_ids"
                                   nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="state"/>
                                    <field name="assigned_user_id"/>
                                </list>
                            </field>
                        </group>
                    </group>

                    <!-- Stage 7: Lost -->
                    <group string="Stage 7 — Lost" colspan="2">
                        <field name="mudon_lost_reason_id"
                               options="{'no_create_edit': True}"
                               help="Picking a reason advances the lead to Lost."/>
                    </group>

                    <!-- Hidden tracking fields (visible to developers only) -->
                    <group string="SLA / Cron Tracking"
                           groups="base.group_no_one">
                        <field name="mudon_first_contact_logged"/>
                        <field name="mudon_sla_30min_fired"/>
                        <field name="mudon_sla_1hour_fired"/>
                        <field name="mudon_sla_2hour_fired"/>
                        <field name="mudon_qualified_entry_date"/>
                        <field name="mudon_offer_3hr_reminder_idx"/>
                        <field name="mudon_last_15day_reminder_date"/>
                        <field name="mudon_meeting_reminder_3day_sent"/>
                        <field name="mudon_meeting_reminder_2day_sent"/>
                        <field name="mudon_meeting_reminder_1day_sent"/>
                    </group>
                </page>
            </xpath>

            <!--
                Client feedback: "2 budget boxes (Expected Revenue + Budget),
                why 2?". The custom Budget field carries the per-pipeline
                currency (AED for UAE / USD for Turkey) which Odoo's native
                Expected Revenue can't, so Budget is the money field of
                record. Hide the native Expected Revenue on this form to
                remove the duplicate (field kept in DB — reporting untouched).
            -->
            <xpath expr="//label[@for='expected_revenue']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='expected_revenue'][@class='o_input_13ch']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!--
        Color-coded kanban. The Mudon priority rank goes into kanban_state
        / record_top via the computed mudon_card_color_hint badge so the
        4-tier sort (P1 → P4) is visible without touching the upstream
        kanban template structure.
    -->
    <record id="mudon_crm_lead_view_kanban" model="ir.ui.view">
        <field name="name">crm.lead.kanban.mudon</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="mudon_pipeline_kind"/>
                <field name="mudon_service_id"/>
                <field name="mudon_service_code"/>
                <field name="mudon_priority"/>
                <field name="mudon_status_id"/>
                <field name="mudon_card_color_hint"/>
                <field name="mudon_kanban_priority_rank"/>
                <field name="mudon_stage_kind_current"/>
                <field name="mudon_offer_counter"/>
                <field name="mudon_budget"/>
                <field name="mudon_visit_date"/>
                <field name="stage_id"/>
            </xpath>
            <!--
                v19.0.1.2.0 — styled Mudon card block: a stage-coloured
                band header + a priority-coloured left accent + native
                coloured tags for City / Property Type. The block carries
                its own colour coding so it reads at a glance regardless of
                the upstream card chrome. Injected just before <footer> (a
                stable anchor in the Odoo 18+ kanban card structure).
            -->
            <xpath expr="//footer" position="before">
                <div t-if="record.mudon_pipeline_kind.raw_value"
                     t-attf-class="mudon_card_block mudon_prio_#{record.mudon_priority.raw_value or 'normal'}">
                    <!-- Stage band header (colour by stage kind) -->
                    <div t-attf-class="mudon_band mudon_band_#{record.mudon_stage_kind_current.raw_value or 'new_lead'}">
                        <t t-out="record.stage_id.value"/>
                    </div>
                    <!-- Priority + service badges -->
                    <div class="mudon_badges mt-1">
                        <span t-if="record.mudon_priority.raw_value == 'urgent'"
                              class="badge text-bg-danger me-1">🔴 Urgent</span>
                        <span t-if="record.mudon_priority.raw_value == 'normal'"
                              class="badge text-bg-warning me-1">🟡 Normal</span>
                        <span t-if="record.mudon_service_code.raw_value == 'investment'"
                              class="badge text-bg-primary me-1">🟦 Investment</span>
                        <span t-if="record.mudon_service_code.raw_value == 'citizenship'"
                              class="badge text-bg-success me-1">🟩 Citizenship</span>
                        <span t-if="record.mudon_service_code.raw_value == 'goldenvisa'"
                              class="badge text-bg-success me-1">🟩 Golden Visa</span>
                    </div>
                    <!-- Coloured tags: city + property type -->
                    <div class="mudon_tags mt-1">
                        <field name="mudon_city_id"/>
                        <field name="mudon_property_type_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}"/>
                    </div>
                    <!-- Budget + offers -->
                    <div class="mudon_meta mt-1 small text-muted">
                        <span t-if="record.mudon_budget.raw_value" class="me-2">
                            💰 <t t-out="record.mudon_budget.value"/>
                        </span>
                        <span t-if="record.mudon_offer_counter.raw_value"
                              class="badge text-bg-secondary">
                            Offers: <t t-out="record.mudon_offer_counter.value"/>
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="mudon_crm_lead_view_search" model="ir.ui.view">
        <field name="name">crm.lead.search.mudon</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="mudon_turkey" string="Mudon Turkey"
                        domain="[('mudon_pipeline_kind', '=', 'turkey')]"/>
                <filter name="mudon_uae" string="Mudon UAE Dubai"
                        domain="[('mudon_pipeline_kind', '=', 'uae')]"/>
                <separator/>
                <filter name="mudon_urgent" string="Urgent"
                        domain="[('mudon_priority', '=', 'urgent')]"/>
                <filter name="mudon_p1" string="P1 — Urgent + Citizenship/GV"
                        domain="[('mudon_card_color_hint', '=', 'urgent_special')]"/>
                <filter name="mudon_p2" string="P2 — Urgent + Investment"
                        domain="[('mudon_card_color_hint', '=', 'urgent_invest')]"/>
                <filter name="mudon_p3" string="P3 — Normal + Citizenship/GV"
                        domain="[('mudon_card_color_hint', '=', 'normal_special')]"/>
                <filter name="mudon_p4" string="P4 — Normal + Investment"
                        domain="[('mudon_card_color_hint', '=', 'normal_invest')]"/>
                <separator/>
                <filter name="mudon_not_contacted"
                        string="Not contacted yet"
                        domain="[
                            ('mudon_first_contact_logged', '=', False),
                            ('mudon_pipeline_kind', 'in', ('turkey', 'uae'))]"/>
                <filter name="mudon_high_offers" string="Offers ≥ 3"
                        domain="[('mudon_offer_counter', '>=', 3)]"/>
                <separator/>
                <filter name="mudon_group_stage" string="Stage"
                        context="{'group_by': 'stage_id'}"/>
                <filter name="mudon_group_service" string="Service"
                        context="{'group_by': 'mudon_service_id'}"/>
                <filter name="mudon_group_status" string="Status"
                        context="{'group_by': 'mudon_status_id'}"/>
                <filter name="mudon_group_branch" string="Branch"
                        context="{'group_by': 'mudon_branch_id'}"/>
                <filter name="mudon_group_source" string="Source"
                        context="{'group_by': 'mudon_source_id'}"/>
                <filter name="mudon_group_agent" string="Agent"
                        context="{'group_by': 'user_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
