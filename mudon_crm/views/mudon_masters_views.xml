<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        v19.0.1.2.0 — One file holds the list+form views + actions for
        the 7 new admin-managed master tables (Services, Cities,
        Statuses, Purposes, Property Types, Sources, Lost Reasons).
        Pattern is the same across all six flat ones; lost.reason has
        the extra parent_id hierarchy at the bottom.
    -->

    <!-- ============ SERVICE ============ -->
    <record id="mudon_service_view_tree" model="ir.ui.view">
        <field name="name">mudon.service.tree</field>
        <field name="model">mudon.service</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Services">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="pipeline_kind"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">mudon.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ CITY ============ -->
    <record id="mudon_city_view_tree" model="ir.ui.view">
        <field name="name">mudon.city.tree</field>
        <field name="model">mudon.city</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Cities">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="pipeline_kind"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_city_action" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">mudon.city</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ LEAD STATUS ============ -->
    <record id="mudon_lead_status_view_tree" model="ir.ui.view">
        <field name="name">mudon.lead.status.tree</field>
        <field name="model">mudon.lead.status</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Lead Statuses">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_lost_signal"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_lead_status_action" model="ir.actions.act_window">
        <field name="name">Lead Statuses</field>
        <field name="res_model">mudon.lead.status</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ PURPOSE ============ -->
    <record id="mudon_purpose_view_tree" model="ir.ui.view">
        <field name="name">mudon.purpose.tree</field>
        <field name="model">mudon.purpose</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Purposes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="pipeline_kind"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_purpose_action" model="ir.actions.act_window">
        <field name="name">Purposes</field>
        <field name="res_model">mudon.purpose</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ PROPERTY TYPE ============ -->
    <record id="mudon_property_type_view_tree" model="ir.ui.view">
        <field name="name">mudon.property.type.tree</field>
        <field name="model">mudon.property.type</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Property Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">mudon.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ SOURCE ============ -->
    <record id="mudon_source_view_tree" model="ir.ui.view">
        <field name="name">mudon.source.tree</field>
        <field name="model">mudon.source</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Lead Sources">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="channel"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_source_action" model="ir.actions.act_window">
        <field name="name">Lead Sources</field>
        <field name="res_model">mudon.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ LOST REASON (hierarchical) ============ -->
    <record id="mudon_lost_reason_view_tree" model="ir.ui.view">
        <field name="name">mudon.lost.reason.tree</field>
        <field name="model">mudon.lost.reason</field>
        <field name="arch" type="xml">
            <list string="Lost Reasons">
                <field name="complete_name"/>
                <field name="code"/>
                <field name="parent_id" optional="show"/>
                <field name="is_category" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_lost_reason_view_form" model="ir.ui.view">
        <field name="name">mudon.lost.reason.form</field>
        <field name="model">mudon.lost.reason</field>
        <field name="arch" type="xml">
            <form string="Lost Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="parent_id"
                               placeholder="Leave empty for a top-level category"/>
                        <field name="is_category" readonly="1"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mudon_lost_reason_action" model="ir.actions.act_window">
        <field name="name">Lost Reasons</field>
        <field name="res_model">mudon.lost.reason</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_sequence': 10}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define lead Lost Reasons.
            </p>
            <p>
                Top-level rows (no parent) are categories. Sub-rows
                (with a parent) are the actual reasons the agent picks
                on a lost lead.
            </p>
        </field>
    </record>

    <!-- ============ PROJECT ============ -->
    <record id="mudon_project_view_tree" model="ir.ui.view">
        <field name="name">mudon.project.tree</field>
        <field name="model">mudon.project</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Projects">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="developer_id"/>
                <field name="pipeline_kind"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_project_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">mudon.project</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a property project.
            </p>
            <p>
                Link each project to its developer; the WON-stage form
                shows projects filtered by the lead's pipeline.
            </p>
        </field>
    </record>

    <!-- ============ LIVING CITY (2026-08-10 round, field change 6) ============ -->
    <record id="mudon_living_city_view_tree" model="ir.ui.view">
        <field name="name">mudon.living.city.tree</field>
        <field name="model">mudon.living.city</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Living Cities">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_living_city_action" model="ir.actions.act_window">
        <field name="name">Living Cities</field>
        <field name="res_model">mudon.living.city</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the cities your clients live in</p>
            <p>Set a Country on a row and the lead form will only offer that
               city once the matching Living Country is chosen.</p>
        </field>
    </record>

    <!-- ============ PROPERTY AREA (field change 7) ============ -->
    <record id="mudon_property_area_view_tree" model="ir.ui.view">
        <field name="name">mudon.property.area.tree</field>
        <field name="model">mudon.property.area</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Property Areas">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="city_id"/>
                <field name="pipeline_kind"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_property_area_action" model="ir.actions.act_window">
        <field name="name">Property Areas</field>
        <field name="res_model">mudon.property.area</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the areas clients ask for</p>
            <p>Marina, Downtown, Besiktas and so on. Leads can carry several.
               Pipeline decides which board offers the area.</p>
        </field>
    </record>

    <!-- ============ COMMISSION TYPE (field change 11) ============ -->
    <record id="mudon_commission_type_view_tree" model="ir.ui.view">
        <field name="name">mudon.commission.type.tree</field>
        <field name="model">mudon.commission.type</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Commission Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="mudon_commission_type_action" model="ir.actions.act_window">
        <field name="name">Commission Types</field>
        <field name="res_model">mudon.commission.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
