<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mudon_quick_fill_wizard_form" model="ir.ui.view">
        <field name="name">mudon.quick.fill.wizard.form</field>
        <field name="model">mudon.quick.fill.wizard</field>
        <field name="arch" type="xml">
            <form string="Fill Required Fields">
                <sheet>
                    <field name="lead_id" invisible="1"/>
                    <field name="target_stage_id" invisible="1"/>
                    <field name="target_stage_kind" invisible="1"/>
                    <field name="pipeline_kind" invisible="1"/>
                    <field name="mudon_need_qualify" invisible="1"/>
                    <field name="mudon_need_offer" invisible="1"/>
                    <field name="mudon_need_visit" invisible="1"/>
                    <field name="mudon_need_booking" invisible="1"/>
                    <field name="mudon_need_paid" invisible="1"/>
                    <group>
                        <!-- Qualified — the 4 mandatory intake fields -->
                        <field name="mudon_service_id"
                               options="{'no_create_edit': True}"
                               domain="[('pipeline_kind', 'in', [pipeline_kind, 'any'])]"
                               required="mudon_need_qualify"
                               invisible="not mudon_need_qualify"/>
                        <field name="mudon_city_id"
                               options="{'no_create_edit': True}"
                               domain="[('pipeline_kind', 'in', [pipeline_kind, 'any'])]"
                               required="mudon_need_qualify"
                               invisible="not mudon_need_qualify"/>
                        <field name="mudon_priority"
                               required="mudon_need_qualify"
                               invisible="not mudon_need_qualify"/>
                        <field name="mudon_budget_currency_id" invisible="1"/>
                        <field name="expected_revenue"
                               required="mudon_need_qualify"
                               invisible="not mudon_need_qualify"/>

                        <!-- Confirm each SKIPPED milestone -->
                        <separator string="Confirm the steps being skipped"
                                   invisible="not (mudon_need_offer or mudon_need_visit or mudon_need_booking or mudon_need_paid)"/>
                        <field name="mudon_tick_offer_sent" widget="boolean_toggle"
                               invisible="not mudon_need_offer"/>
                        <field name="mudon_visit_confirmed" widget="boolean_toggle"
                               invisible="not mudon_need_visit"/>
                        <!-- Required with the tick for a move to Meeting, so it
                             has to be fillable here or the dialog asks for
                             something it never shows. -->
                        <field name="mudon_visit_date"
                               invisible="not mudon_need_visit"
                               required="mudon_need_visit"/>
                        <field name="mudon_paid_booking" widget="boolean_toggle"
                               invisible="not mudon_need_booking"/>
                        <field name="mudon_fully_paid" widget="boolean_toggle"
                               invisible="not mudon_need_paid"/>

                        <!-- Lost-only field -->
                        <field name="mudon_lost_reason_id"
                               options="{'no_create_edit': True}"
                               required="target_stage_kind == 'lost'"
                               invisible="target_stage_kind != 'lost'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Save &amp; Move Forward"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mudon_quick_fill_wizard" model="ir.actions.act_window">
        <field name="name">Fill Required Fields</field>
        <field name="res_model">mudon.quick.fill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
