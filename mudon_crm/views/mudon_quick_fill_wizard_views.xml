<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mudon_quick_fill_wizard_form" model="ir.ui.view">
        <field name="name">mudon.quick.fill.wizard.form</field>
        <field name="model">mudon.quick.fill.wizard</field>
        <field name="arch" type="xml">
            <form string="Fill Required Fields">
                <sheet>
                    <field name="lead_id" invisible="1"/>
                    <field name="target_stage_id" invisible="1"/>
                    <field name="target_stage_kind" invisible="1"/>
                    <field name="pipeline_kind" invisible="1"/>
                    <group>
                        <!-- Required-to-qualify fields (moving out of New Lead) -->
                        <field name="mudon_service_id"
                               options="{'no_create_edit': True}"
                               domain="[('pipeline_kind', 'in', [pipeline_kind, 'any'])]"
                               invisible="target_stage_kind in ('new_lead', 'lost') or not pipeline_kind"/>
                        <field name="mudon_city_id"
                               options="{'no_create_edit': True}"
                               domain="[('pipeline_kind', 'in', [pipeline_kind, 'any'])]"
                               invisible="target_stage_kind in ('new_lead', 'lost') or not pipeline_kind"/>
                        <field name="mudon_priority"
                               invisible="target_stage_kind in ('new_lead', 'lost')"/>
                        <field name="mudon_budget_currency_id" invisible="1"/>
                        <field name="mudon_budget"
                               invisible="target_stage_kind in ('new_lead', 'lost')"/>

                        <!-- Lost-only field -->
                        <field name="mudon_lost_reason_id"
                               options="{'no_create_edit': True}"
                               invisible="target_stage_kind != 'lost'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Save &amp; Move Forward"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mudon_quick_fill_wizard" model="ir.actions.act_window">
        <field name="name">Fill Required Fields</field>
        <field name="res_model">mudon.quick.fill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
