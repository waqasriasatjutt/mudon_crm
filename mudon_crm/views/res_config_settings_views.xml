<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_mudon" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mudon</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Mudon CRM" string="Mudon CRM" name="mudon_crm">
                    <block title="WhatsApp — Meta Cloud API"
                           name="mudon_wa_setting_container">
                        <setting string="WhatsApp mode"
                                 help="Keep on Stub until the credentials below are set and tested on the dev site. Switch to Meta Cloud API to start sending for real.">
                            <field name="mudon_wa_provider" widget="radio"/>
                        </setting>
                        <setting string="Meta access token"
                                 help="Permanent System-User token from Meta Business. Stored on this system only — never in the code.">
                            <field name="mudon_wa_access_token" password="True"
                                   placeholder="EAAG..."/>
                        </setting>
                        <setting string="WhatsApp Business Account ID"
                                 help="From Meta &gt; WhatsApp &gt; API Setup. The account your numbers sit under. The token above covers every number in it.">
                            <field name="mudon_wa_waba_id"
                                   placeholder="e.g. 987654321098765"/>
                        </setting>
                        <setting string="One number per funnel"
                                 help="Dubai and Turkey each sending from their own number is set up under Mudon CRM &gt; Configuration &gt; WhatsApp Numbers — one row per number. The default below is only used for a pipeline that has no number of its own.">
                            <button name="%(mudon_crm.mudon_wa_sender_action)d"
                                    type="action" string="WhatsApp Numbers"
                                    class="btn-link" icon="fa-arrow-right"/>
                        </setting>
                        <setting string="Default phone-number ID"
                                 help="Fallback only. From Meta &gt; WhatsApp &gt; API Setup.">
                            <field name="mudon_wa_phone_number_id"
                                   placeholder="e.g. 123456789012345"/>
                        </setting>
                        <setting string="Company phone-number ID"
                                 help="Separate number for the 3rd-offer client survey. Leave blank to reuse the sending number.">
                            <field name="mudon_wa_company_phone_number_id"/>
                        </setting>
                        <setting string="Company number (display)">
                            <field name="mudon_wa_company_number"
                                   placeholder="+971..."/>
                        </setting>
                        <setting string="Webhook verify token"
                                 help="Any secret string; enter the same value in the Meta App webhook. Callback URL: your-domain/mudon/wa/webhook">
                            <field name="mudon_wa_verify_token"/>
                        </setting>
                        <setting string="Graph API version">
                            <field name="mudon_wa_api_version"
                                   placeholder="v21.0"/>
                        </setting>
                    </block>
                    <block title="Meta Lead Ads" name="mudon_meta_setting_container">
                        <setting string="Meta page access token"
                                 help="A PAGE token with the leads_retrieval permission. This is NOT the WhatsApp token.">
                            <field name="mudon_meta_page_token" password="True"
                                   placeholder="EAAG..."/>
                        </setting>
                        <setting string="Meta app secret"
                                 help="App dashboard &gt; Settings &gt; Basic. Proves an incoming lead really came from Meta.">
                            <field name="mudon_meta_app_secret" password="True"/>
                        </setting>
                        <setting string="Lead webhook verify token"
                                 help="Any secret word; enter the same value on the Meta webhook page. Callback URL: your-domain/mudon/meta/leadgen">
                            <field name="mudon_meta_verify_token"/>
                        </setting>
                    </block>
                    <block title="Notifications" name="mudon_notif_setting_container">
                        <setting string="Marketing user (Lost alerts)"
                                 help="Receives the WhatsApp alert when a lead is marked Lost. Falls back to the sales-team manager if unset.">
                            <field name="mudon_marketing_user_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
