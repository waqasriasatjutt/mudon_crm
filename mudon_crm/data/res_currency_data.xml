<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        v19.0.1.3.0 — the UAE Dubai pipeline bills in AED (Turkey in USD).
        Activate the AED currency so the MBudget / Closing Amount /
        Commission monetary widgets render it. NOT noupdate so it
        re-applies on upgrade for existing tenants, not only fresh installs.
    -->
    <data noupdate="0">
        <record id="base.AED" model="res.currency">
            <field name="active">True</field>
        </record>
    </data>

    <!--
        Seed the standard AED↔USD peg (1 USD = 3.6725 AED) so any future
        multi-currency reporting converts sanely instead of falling back to
        1:1. noupdate so the client can adjust the rate under
        Accounting → Currencies without it being reset on the next upgrade.
    -->
    <data noupdate="1">
        <record id="mudon_aed_rate_seed" model="res.currency.rate">
            <field name="currency_id" ref="base.AED"/>
            <field name="name">2020-01-01</field>
            <field name="rate">3.6725</field>
        </record>
    </data>
</odoo>
