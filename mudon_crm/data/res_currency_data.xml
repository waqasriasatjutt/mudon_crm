<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        v19.0.1.3.x — the UAE Dubai pipeline bills in AED (Turkey in USD).
        AED is ACTIVATED in code (post_init_hook on fresh install +
        migration on upgrade), because a base currency's xmlid is noupdate
        and cannot be flipped from a data file.

        Here we only seed the standard AED↔USD peg (1 USD = 3.6725 AED) so
        any future multi-currency reporting converts sanely instead of
        falling back to 1:1. noupdate so the client can adjust the rate
        under Accounting → Currencies without it being reset on upgrade.
    -->
    <data noupdate="1">
        <record id="mudon_aed_rate_seed" model="res.currency.rate">
            <field name="currency_id" ref="base.AED"/>
            <field name="name">2020-01-01</field>
            <field name="rate">3.6725</field>
        </record>
    </data>
</odoo>
