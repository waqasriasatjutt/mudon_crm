<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Two crons sweep Mudon leads on a 5-minute cadence and fire the
        agent reminder / manager escalation whenever:
          • the lead is past its threshold (30 or 60 minutes since create)
          • no chatter message from the assigned agent has landed yet
          • the same SLA hasn't already fired (avoids duplicate pings)

        5-minute interval is a reasonable trade-off between responsiveness
        and database load: in the worst case the agent gets the reminder
        at ~35 minutes (not exactly 30), which the proposal treats as
        acceptable since WA delivery itself isn't second-precision.
    -->
    <record id="mudon_cron_sla_30min" model="ir.cron">
        <field name="name">Mudon — SLA 30-min reminder</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._mudon_cron_sla_30min()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="mudon_cron_sla_1hour" model="ir.cron">
        <field name="name">Mudon — SLA 1-hour escalation</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._mudon_cron_sla_1hour()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
