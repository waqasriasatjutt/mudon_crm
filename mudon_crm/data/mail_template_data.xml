<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Mail templates carry the message bodies that are pushed to
        WhatsApp via the `_mudon_send_whatsapp` abstraction. Stored
        as mail.template so the client can edit copy in the UI
        without a code deploy.

        Today the senders interpolate Python strings inline; the
        templates are also wired so future provider switches (Meta
        Cloud / Twilio / 360Dialog) can render them through Odoo's
        Jinja-style engine without changing the senders.
    -->
    <record id="mudon_template_client_greeting" model="mail.template">
        <field name="name">Mudon — Client greeting on new lead</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">Thank you for contacting Mudon</field>
        <field name="body_html" type="html">
            <p>Thank you for contacting Mudon<br/>
            One of our property advisors will contact you shortly.</p>
            <p dir="rtl" lang="ar">شكراً لتواصلكم مع مدن<br/>
            سيقوم مستشار عقاري بالتواصل معكم قريباً.</p>
        </field>
    </record>

    <record id="mudon_template_agent_new_lead" model="mail.template">
        <field name="name">Mudon — Agent new-lead notification</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">You have new client!</field>
        <field name="body_html" type="html">
            <p><b>You have new client!</b></p>
            <p>Name: <t t-out="object.contact_name or object.name or ''"/></p>
        </field>
    </record>

    <record id="mudon_template_agent_qualified" model="mail.template">
        <field name="name">Mudon — Agent qualified-client notification</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
