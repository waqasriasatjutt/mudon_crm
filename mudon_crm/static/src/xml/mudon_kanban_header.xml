<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Comment 23 - "On top of each stage, I need to see the number of cards
        ... there should be total leads in that stage", placed before the
        revenue total.

        Odoo renders the column aggregate through web.ColumnProgress, which
        ends with an AnimatedNumber holding the summed revenue. The lead count
        goes immediately before it, so the row reads:

            [progress bar]            Leads: 10      367k AED

        `props.group.count` is the record count Odoo already uses for the bar
        widths, so it always agrees with the column contents.
    -->
    <t t-name="mudon_crm.ColumnProgressLeadCount"
       t-inherit="web.ColumnProgress" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.progressBar.isReady']" position="before">
            <span class="mudon_lead_count" t-if="!props.group.isFolded">
                Leads: <t t-esc="props.group.count"/>
            </span>
        </xpath>
    </t>

</templates>
