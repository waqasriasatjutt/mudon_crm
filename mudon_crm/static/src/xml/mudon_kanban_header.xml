<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Comment 23 - "there should be total leads in that stage", shown before
        the revenue total on the kanban column row:

            [progress bar]            Leads: 10      367k AED

        Odoo renders the column aggregate through web.ColumnProgress, which
        ends with an AnimatedNumber holding the summed revenue. The insertion
        point is written as an <AnimatedNumber position="before"> selector,
        which is the form core itself uses for this same template (see
        mail/static/src/js/rotting_mixin/rotting_column_progress.xml). An
        equivalent xpath expression did not take effect here.

        `props.group.count` is the record count Odoo already uses to size the
        progress bars, so it cannot disagree with the column contents.
    -->
    <t t-name="mudon_crm.ColumnProgressLeadCount"
       t-inherit="web.ColumnProgress" t-inherit-mode="extension">
        <AnimatedNumber position="before">
            <span class="mudon_lead_count">
                Leads: <t t-esc="props.group.count"/>
            </span>
        </AnimatedNumber>
    </t>

</templates>
